---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignalTrace from '../../components/SignalTrace.astro';
import { href } from '../../lib/url';
import { getPublications } from '../../lib/content';
import { formatDate } from '../../lib/dates';

export async function getStaticPaths() {
  const pubs = await getPublications();
  return pubs.map((publication) => ({ params: { slug: publication.id }, props: { publication } }));
}

const { publication } = Astro.props;
const { data } = publication;
const { Content } = await render(publication);
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="container article">
    <header class="stack" style="--stack-gap: 14px">
      <a class="back" href={href('/publications')}>← All publications</a>
      <p class="eyebrow">{data.type} · <time datetime={data.date}>{formatDate(data.date)}</time></p>
      <h1>{data.title}</h1>
      <p class="lede">{data.summary}</p>
      {data.authors.length > 0 && <p class="by">By {data.authors.join(', ')}</p>}
      <SignalTrace width={120} />
    </header>

    {
      data.cover && (
        <Image class="cover" src={data.cover} alt={data.cover_alt ?? ''} widths={[640, 960, 1280]} sizes="(max-width: 820px) 100vw, 780px" loading="eager" />
      )
    }

    <div class="prose"><Content /></div>

    {
      data.pdf && (
        <p class="pdf">
          <a class="btn btn-secondary" href={href(data.pdf)} download>Download the PDF version</a>
        </p>
      )
    }

    {
      data.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {data.tags.map((t) => <li>{t}</li>)}
        </ul>
      )
    }
  </article>
</BaseLayout>

<style>
  .article {
    max-width: calc(780px + 2 * var(--gutter));
    padding-top: 48px;
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .article h1 {
    font-size: clamp(34px, 5vw, 50px);
  }
  .back {
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    align-self: flex-start;
    padding: 6px 0;
  }
  .back:hover {
    text-decoration: underline;
  }
  .by {
    font-weight: 600;
  }
  .cover {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--blue-soft);
    color: var(--blue);
  }
</style>
