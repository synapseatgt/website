---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPage, getOfficers, getSettings } from '../lib/content';

const page = await getPage('about');
const { Content } = await render(page);
const { current, past } = await getOfficers();
const settings = await getSettings();
const initials = (name: string) =>
  name
    .replace(/[\[\]]/g, '')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase())
    .join('');

const pastByTerm = Object.entries(
  past.reduce<Record<string, typeof past>>((acc, o) => {
    (acc[o.data.term] ??= []).push(o);
    return acc;
  }, {}),
);
---

<BaseLayout title="About" description={page.data.description}>
  <PageHeader title={page.data.title} intro={page.data.description} />

  <section class="section container">
    <div class="prose"><Content /></div>
  </section>

  <section class="band" aria-labelledby="board-heading">
    <div class="section container">
      <div class="stack" style="--stack-gap: 8px; margin-bottom: 32px">
        <h2 id="board-heading">The people running Synapse</h2>
        {current[0] && <p class="meta-line">{current[0].data.term} executive board</p>}
      </div>
      <ul class="board">
        {
          current.map((o) => (
            <li class="card person">
              {o.data.photo ? (
                <Image class="photo" src={o.data.photo} alt={o.data.photo_alt ?? ''} width={240} height={240} />
              ) : (
                <span class="photo initials" aria-hidden="true">{initials(o.data.name)}</span>
              )}
              <div>
                <h3>{o.data.link ? <a href={o.data.link}>{o.data.name}</a> : o.data.name}</h3>
                <p class="pos">{o.data.position}</p>
                {(o.data.major || o.data.year) && (
                  <p class="tag">{[o.data.major, o.data.year].filter(Boolean).join(' · ')}</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      {
        settings.show_advisor && settings.advisor_name && (
          <div class="advisor">
            <h3 class="sub-h">Faculty advisor</h3>
            <p>
              <strong>{settings.advisor_url ? <a href={settings.advisor_url}>{settings.advisor_name}</a> : settings.advisor_name}</strong>
              {settings.advisor_title && <>, {settings.advisor_title}</>}
            </p>
          </div>
        )
      }
    </div>
  </section>

  {
    pastByTerm.length > 0 && (
      <section class="section container" aria-labelledby="alumni-heading">
        <h2 id="alumni-heading" class="alumni-h">Past boards</h2>
        <div class="alumni">
          {pastByTerm.map(([term, people]) => (
            <div>
              <h3 class="sub-h">{term}</h3>
              <ul>
                {people.map((o) => (
                  <li>
                    {o.data.name}, <span class="muted">{o.data.position}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .board {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 20px;
  }
  .person {
    padding: 20px;
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .photo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--blue-soft);
    color: var(--blue);
    font-weight: 800;
    font-size: 22px;
    box-shadow: inset 0 0 0 3px #fff, 0 0 0 2px var(--yellow);
  }
  .person h3 {
    font-size: 18px;
  }
  .person h3 a {
    text-decoration: none;
  }
  .person h3 a:hover {
    text-decoration: underline;
  }
  .pos {
    font-weight: 600;
    font-size: 15px;
  }
  .advisor {
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sub-h {
    font-size: 18px;
  }
  .alumni-h {
    font-size: 26px;
    margin-bottom: 20px;
  }
  .alumni {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 28px;
  }
  .alumni ul {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
