---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPage, getSettings } from '../lib/content';

const page = await getPage('contact');
const { Content } = await render(page);
const settings = await getSettings();
---

<BaseLayout title="Contact" description={page.data.description}>
  <PageHeader eyebrow="Contact" title="Get in touch" intro="The quickest way to reach us is email. For specific requests, use one of the forms below." />

  <section class="section container grid">
    <div class="card direct">
      <h2>Reach us directly</h2>
      <dl>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd>
        </div>
        {
          settings.instagram_url && (
            <div>
              <dt>Instagram</dt>
              <dd><a href={settings.instagram_url}>Follow Synapse on Instagram</a></dd>
            </div>
          )
        }
      </dl>
    </div>

    {
      settings.contact_forms.length > 0 && (
        <div>
          <h2 class="forms-h">Forms</h2>
          <ul class="forms">
            {settings.contact_forms.map((f) => (
              <li class="card card-link">
                <a class="stretched" href={f.url}>{f.label}</a>
                {f.description && <p class="muted">{f.description}</p>}
                <span class="opens mono" aria-hidden="true">Opens a Google Form ↗</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <section class="container privacy">
    <div class="prose"><Content /></div>
  </section>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 40px;
    align-items: start;
  }
  .direct {
    padding: 28px;
    border-top: 4px solid var(--yellow);
  }
  .direct h2,
  .forms-h {
    font-size: 24px;
    margin-bottom: 18px;
  }
  dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  dd {
    margin: 4px 0 0;
    font-size: 18px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .forms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .forms li {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .forms .stretched {
    font-weight: 800;
    font-size: 18px;
    color: var(--blue);
  }
  .opens {
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
  }
  .privacy {
    padding-bottom: 80px;
  }
  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
