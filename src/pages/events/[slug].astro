---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Network from '../../components/Network.astro';
import { href } from '../../lib/url';
import { getEvents, getSettings, hasDetailPage } from '../../lib/content';
import { formatLongDate, formatTimeRange, machine, wallToDate, eventEnd } from '../../lib/dates';
import { hashString } from '../../lib/network';

// Only events with a long description get their own page.
export async function getStaticPaths() {
  const events = (await getEvents()).filter(hasDetailPage);
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { data } = event;
const { Content } = await render(event);
const settings = await getSettings();
const isPast = eventEnd(data.start, data.end ?? undefined) < new Date();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: data.title,
  description: data.summary,
  startDate: wallToDate(data.start).toISOString(),
  ...(data.end ? { endDate: wallToDate(data.end).toISOString() } : {}),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: data.location, address: 'Georgia Tech, Atlanta, GA' },
  organizer: { '@type': 'Organization', name: settings.site_title, url: new URL(href('/'), Astro.site).href },
};
---

<BaseLayout title={data.title} description={data.summary} jsonLd={jsonLd}>
  <section class="band head">
    <div class="net" aria-hidden="true"><Network seed={hashString(event.id)} width={700} height={360} count={24} /></div>
    <div class="container inner">
      <a class="back" href={href('/events')}>← All events</a>
      <p class="eyebrow">{data.category}{isPast && ' · Past event'}</p>
      <h1>{data.title}</h1>
      <p class="when">
        <time datetime={machine(data.start)}>{formatLongDate(data.start)}</time>
        {formatTimeRange(data.start, data.end ?? undefined) && <> · {formatTimeRange(data.start, data.end ?? undefined)}</>}
        <br />{data.location}
      </p>
      {
        !isPast && (
          <div class="btn-row">
            {data.registration_url && <a class="btn btn-primary" href={data.registration_url}>Register</a>}
            <a class="btn btn-secondary" href={href(`/events/${event.id}.ics`)} download>Add to calendar</a>
          </div>
        )
      }
    </div>
  </section>

  <div class="section container">
    {
      data.image && (
        <Image class="img" src={data.image} alt={data.image_alt ?? ''} widths={[640, 960, 1280]} sizes="(max-width: 860px) 100vw, 860px" />
      )
    }
    <p class="lede summary">{data.summary}</p>
    <div class="prose"><Content /></div>
    <p class="host">Hosted by Synapse, a student organization at Georgia Tech.</p>
  </div>
</BaseLayout>

<style>
  .head {
    position: relative;
    overflow: hidden;
    border-top: 0;
  }
  .net {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(50%, 700px);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 50%);
    mask-image: linear-gradient(to right, transparent, #000 50%);
  }
  .inner {
    position: relative;
    padding-top: 40px;
    padding-bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .inner h1 {
    font-size: clamp(34px, 5vw, 52px);
    max-width: 22ch;
  }
  .back {
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    align-self: flex-start;
    padding: 6px 0;
  }
  .back:hover {
    text-decoration: underline;
  }
  .when {
    font-size: 18px;
    font-weight: 600;
  }
  .img {
    width: 100%;
    max-width: 860px;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    margin-bottom: 32px;
  }
  .summary {
    margin-bottom: 24px;
  }
  .host {
    margin-top: 40px;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .net {
      width: 100%;
      opacity: 0.3;
    }
  }
</style>
