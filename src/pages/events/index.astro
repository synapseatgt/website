---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventItem from '../../components/EventItem.astro';
import FilterBar from '../../components/FilterBar.astro';
import { href } from '../../lib/url';
import { getEventsSplit, getSettings, hasDetailPage } from '../../lib/content';
import { wallToDate } from '../../lib/dates';
import { EVENT_CATEGORIES } from '../../content.config';

const settings = await getSettings();
const { upcoming, past } = await getEventsSplit();

const jsonLd = upcoming.map((e) => ({
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.data.title,
  description: e.data.summary,
  startDate: wallToDate(e.data.start).toISOString(),
  ...(e.data.end ? { endDate: wallToDate(e.data.end).toISOString() } : {}),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: e.data.location, address: 'Georgia Tech, Atlanta, GA' },
  organizer: { '@type': 'Organization', name: settings.site_title, url: new URL(href('/'), Astro.site).href },
  ...(hasDetailPage(e) ? { url: new URL(href(`/events/${e.id}`), Astro.site).href } : {}),
}));
---

<BaseLayout
  title="Events"
  description="General body meetings, workshops, journal clubs and speaker events from Synapse at Georgia Tech."
  jsonLd={jsonLd}
>
  <PageHeader title="On the calendar" />

  <section class="section container" aria-labelledby="upcoming-heading">
    <h2 id="upcoming-heading">Upcoming</h2>
    <FilterBar label="Filter events by type" categories={EVENT_CATEGORIES} />
    <ul class="list" data-filterable data-upcoming-list data-empty-id="no-upcoming">
      {upcoming.map((e) => <EventItem event={e} />)}
    </ul>
    <p id="no-upcoming" class="empty-note" hidden={upcoming.length > 0}>
      No events are scheduled yet. New events are posted on{' '}
      {settings.instagram_url ? <a href={settings.instagram_url}>Instagram</a> : 'Instagram'} first.
    </p>
    <p class="empty-note" data-filter-empty hidden>No upcoming events of this type.</p>
  </section>

  {
    past.length > 0 && (
      <section class="band" aria-labelledby="past-heading">
        <div class="section container">
          <h2 id="past-heading">Past events</h2>
          <ul class="list past" data-filterable>
            {past.map((e) => <EventItem event={e} />)}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  h2 {
    margin-bottom: 20px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 860px;
  }
  .past :global(.links a[download]) {
    display: none;
  }
</style>
