---
import { Image } from 'astro:assets';
import logo from '../assets/brand/synapse-mark.png';
import { href, isActive } from '../lib/url';

const nav = [
  { label: 'About', path: '/about' },
  { label: 'Projects', path: '/projects' },
  { label: 'Events', path: '/events' },
  { label: 'Publications', path: '/publications' },
  { label: 'Contact', path: '/contact' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href('/')}>
      <Image src={logo} alt="" width={44} height={44} densities={[1, 2]} loading="eager" />
      <span class="lockup">
        <span class="name">Synapse</span>
        <span class="sub"><span class="visually-hidden">, </span>Neurotechnology Club at Georgia Tech</span>
      </span>
    </a>

    <div class="actions">
      <nav aria-label="Main" id="site-nav" class="nav">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={href(item.path)} aria-current={isActive(current, item.path) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="btn btn-primary join" href={href('/get-involved')}>Join Synapse</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="visually-hidden">Menu</span>
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path class="l1" d="M4 7h16"></path>
          <path class="l2" d="M4 12h16"></path>
          <path class="l3" d="M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Solid background on purpose: backdrop-filter would trap the fixed mobile menu inside the header. */
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--blue);
    min-width: 0;
  }
  .brand img {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }
  .lockup {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .name {
    font-weight: 800;
    font-size: 21px;
    letter-spacing: -0.02em;
  }
  .sub {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.03em;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 8px;
  }
  .nav a {
    display: inline-block;
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    padding: 10px 10px;
    border-radius: 8px;
  }
  .nav a:hover {
    color: var(--blue);
    background: var(--blue-soft);
  }
  .nav a[aria-current='page'] {
    color: var(--blue);
    box-shadow: inset 0 -2px 0 var(--yellow);
    border-radius: 0;
  }
  .join {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 15px;
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: 1.5px solid var(--line);
    background: #fff;
    color: var(--blue);
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .menu-btn path {
    transition: transform 0.2s ease, opacity 0.2s ease;
    transform-origin: center;
  }
  .menu-btn[aria-expanded='true'] .l1 {
    transform: translateY(5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .l2 {
    opacity: 0;
  }
  .menu-btn[aria-expanded='true'] .l3 {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (max-width: 1020px) {
    .sub {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .menu-btn {
      display: inline-flex;
    }
    .actions {
      gap: 10px;
    }
    .nav {
      display: none;
      position: fixed;
      inset: 72px 0 0 0;
      background: #fff;
      padding: 24px var(--gutter);
      overflow-y: auto;
    }
    .nav.open {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      gap: 4px;
    }
    .nav a {
      display: block;
      font-size: 24px;
      font-weight: 800;
      padding: 14px 4px;
      border-bottom: 1px solid var(--line);
      border-radius: 0;
    }
    .nav a[aria-current='page'] {
      box-shadow: inset 4px 0 0 var(--yellow);
      padding-left: 16px;
    }
  }
  @media (max-width: 420px) {
    .name {
      font-size: 18px;
    }
    .join {
      padding: 10px 14px;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
    window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>
