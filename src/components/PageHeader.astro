---
/** Top band for inner pages: eyebrow, title, intro, with a network on the right. */
import Network from './Network.astro';
import { hashString } from '../lib/network';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="page-header band">
  <div class="net" aria-hidden="true">
    <Network seed={hashString(title)} width={700} height={360} count={26} />
  </div>
  <div class="container inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="lede">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    border-top: 0;
  }
  .net {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(55%, 700px);
    opacity: 0.9;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 45%);
    mask-image: linear-gradient(to right, transparent, #000 45%);
  }
  .inner {
    position: relative;
    padding-top: clamp(48px, 7vw, 88px);
    padding-bottom: clamp(48px, 7vw, 80px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h1 {
    font-size: clamp(38px, 5.4vw, 56px);
    max-width: 18ch;
  }
  @media (max-width: 720px) {
    .net {
      width: 100%;
      opacity: 0.35;
    }
  }
</style>
