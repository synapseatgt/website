---
/** Image area for cards. Uses the uploaded image if there is one, else a small network drawing. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Network from './Network.astro';
import { hashString } from '../lib/network';

interface Props {
  image?: ImageMetadata | null;
  alt?: string;
  seedKey: string;
  ratio?: string;
  eager?: boolean;
}
const { image, alt = '', seedKey, ratio = '16 / 9', eager = false } = Astro.props;
---

<div class="art" style={`aspect-ratio:${ratio}`}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[400, 700, 1000]}
        sizes="(max-width: 720px) 100vw, 400px"
        loading={eager ? 'eager' : 'lazy'}
      />
    ) : (
      <Network seed={hashString(seedKey)} width={480} height={270} count={16} animate={false} />
    )
  }
</div>

<style>
  .art {
    background: var(--tint);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.2s ease;
  }
</style>
