---
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/url';
import { categorySlug } from '../lib/categories';
import { hasDetailPage } from '../lib/content';
import { dayOfMonth, eventEnd, formatLongDate, formatTimeRange, machine, monthShort } from '../lib/dates';

interface Props {
  event: CollectionEntry<'events'>;
  compact?: boolean;
  headingLevel?: 'h2' | 'h3';
  hidden?: boolean;
}
const { event, compact = false, headingLevel = 'h3', hidden = false } = Astro.props;
const { data } = event;
const Heading = headingLevel;
const detail = hasDetailPage(event);
const ends = eventEnd(data.start, data.end ?? undefined).toISOString();
---

<li class:list={['event', { compact }]} data-ends={ends} data-category={categorySlug(data.category)} hidden={hidden}>
  <div class="dateblock" aria-hidden="true">
    <span class="mon">{monthShort(data.start)}</span>
    <span class="day">{dayOfMonth(data.start)}</span>
  </div>
  <div class="info">
    <Heading class="title">
      {detail ? <a href={href(`/events/${event.id}`)}>{data.title}</a> : data.title}
    </Heading>
    <p class="when">
      <time datetime={machine(data.start)}>{formatLongDate(data.start)}</time>
      {formatTimeRange(data.start, data.end ?? undefined) && <> · {formatTimeRange(data.start, data.end ?? undefined)}</>}
      {' · '}{data.location}
    </p>
    {
      !compact && (
        <>
          <p class="summary">{data.summary}</p>
          <p class="links">
            <span class="tag">{data.category}</span>
            {data.registration_url && <a href={data.registration_url}>Register<span class="visually-hidden"> for {data.title}</span></a>}
            <a href={href(`/events/${event.id}.ics`)} download>Add to calendar<span class="visually-hidden">: {data.title}</span></a>
          </p>
        </>
      )
    }
  </div>
</li>

<style>
  .event {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .event[hidden] {
    display: none;
  }
  .compact {
    align-items: center;
  }
  .dateblock {
    width: 76px;
    flex-shrink: 0;
    text-align: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 10px 0 8px;
    background: #fff;
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .mon {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--blue);
    letter-spacing: 0.06em;
  }
  .day {
    font-size: 26px;
    font-weight: 800;
    color: var(--ink);
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .title {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .title a {
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .when {
    color: var(--muted);
    font-size: 15px;
  }
  .summary {
    font-size: 16px;
    margin-top: 4px;
  }
  .links {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 15px;
    margin-top: 6px;
  }
  .links a {
    font-weight: 600;
    padding: 6px 0;
  }
</style>
