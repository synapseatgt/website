---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href } from '../lib/url';
import { getSettings } from '../lib/content';

interface Props {
  /** Page title; " · Synapse at Georgia Tech" is added automatically (except on the home page). */
  title?: string;
  description?: string;
  /** Absolute or site-root path to a share image (1200×630). */
  image?: string;
  /** Structured data (schema.org) for this page. */
  jsonLd?: object | object[];
  noindex?: boolean;
}

const settings = await getSettings();
const { title, description = settings.site_description, image, jsonLd, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${settings.site_title}` : `${settings.site_title} — ${settings.hero_headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(image ?? href('/og-image.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta name="theme-color" content="#004AAD" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.site_title} />
    <meta property="og:title" content={title ?? settings.site_title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <Header />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      // Static sites only know "today" at build time. This hides upcoming events
      // that have finished since the last build (e.g. over summer when the nightly
      // rebuild is paused) and keeps list limits and empty messages correct.
      const now = Date.now();
      document.querySelectorAll<HTMLElement>('[data-upcoming-list]').forEach((list) => {
        const limit = Number(list.dataset.limit || 0);
        const items = Array.from(list.querySelectorAll<HTMLElement>('[data-ends]'));
        let shown = 0;
        for (const item of items) {
          const over = new Date(item.dataset.ends!).getTime() < now;
          const show = !over && (!limit || shown < limit);
          item.hidden = !show;
          if (show) shown++;
          if (over) item.dataset.past = '';
        }
        list.dataset.count = String(shown);
        const empty = document.getElementById(list.dataset.emptyId || '');
        if (empty) empty.hidden = shown > 0;
      });
    </script>
  </body>
</html>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
  }
  main:focus {
    outline: none;
  }
</style>
